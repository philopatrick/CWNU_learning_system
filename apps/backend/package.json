{
  "name": "@cwnu/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "dependencies": {
    "@cwnu/shared": "0.1.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.1"
  },
  "scripts": {
    "dev": "sh -c 'tsc -p tsconfig.json && (tsc -p tsconfig.json --watch --preserveWatchOutput &) && node --watch dist/main.js'",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
